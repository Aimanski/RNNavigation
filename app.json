{
  "expo": {
    "name": "WeighApp",
    "slug": "RNNavigation",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/WeighApp.jpg",
    "scheme": "weighapp",
    "userInterfaceStyle": "automatic",
    "description": "WeighApp is a powerful meal planning and weight tracking application. Log your daily meals, track calories and macros, monitor your weight progress with beautiful charts, and get personalized meal suggestions. Latest feature: Advanced progress analytics and customizable goals to help you stay motivated!",
    "owner": "aimanski",
    "privacy": "public",
    "platforms": [
      "ios",
      "android"
    ],
    "newArchEnabled": true,
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/a2e6d7fc-00f4-4904-8006-06fcf03a1be1"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/WeighApp.jpg",
      "bundleIdentifier": "com.aimanski.weighapp",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/WeighApp.jpg",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#96e235"
      },
      "package": "com.aimanski.weighapp",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "weighapp",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/WeighApp.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#059669",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a2e6d7fc-00f4-4904-8006-06fcf03a1be1"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
